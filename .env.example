# ==========================================
# ArchGraph Configuration Environment Variables
# ==========================================

# --- LLM Provider API Keys ---
# NVIDIA NIM (build.nvidia.com) - Used for Nemotron 3.5 Lightning, Nemotron Ultra, Kimi-k3
NVIDIA_API_KEY=

# Groq API Key (console.groq.com) - Used for ultra-fast Llama 3.3 70B inference
GROQ_API_KEY=

# Anthropic API Key (console.anthropic.com) - Used for Claude 3.7 Sonnet, Claude 3.5 Haiku
ANTHROPIC_API_KEY=

# OpenAI API Key (platform.openai.com)
OPENAI_API_KEY=

# --- GitHub Integration ---
# Optional Personal Access Token (PAT) for private repositories and higher rate limits
GITHUB_TOKEN=

# --- Service Host & Ports ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
BACKEND_URL=http://localhost:8000
